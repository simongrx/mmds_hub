{
  "name": "mmds-plataforma",
  "version": "0.1.0",
  "private": true,
  "description": "Miel Mostaza - Plataforma Digital Completa (monorepo)",
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm -r build",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:generate": "pnpm --filter api db:generate",
    "db:seed": "pnpm --filter api db:seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
