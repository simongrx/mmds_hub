# URL del backend Express. Tiene que coincidir con PORT de apps/api/.env.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Enciende las partes que no funcionan sin API: panel (/dashboard), login,
# portal de cliente (/proyecto) y el envío del formulario de contacto.
#
# Sin declarar, esas rutas responden 404 y el formulario se sustituye por un
# enlace de correo. Es el valor seguro y por eso es el de por defecto: la
# landing se publica entera y nada aparenta funcionar sin hacerlo.
#
# Ponlo a "true" en local (hay API) y en producción sólo cuando la API esté
# desplegada de verdad y NEXT_PUBLIC_API_URL apunte a ella.
NEXT_PUBLIC_BACKEND_ENABLED=true

# Dominio público, usado por sitemap.xml y robots.txt.
# NEXT_PUBLIC_SITE_URL=https://mielmostaza.com
